# Environment Configuration for Factory Reliability Command Center
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env for local overrides.

APP_ENV=development
APP_NAME="Factory Reliability Command Center"
LOG_LEVEL=INFO

# Storage Backend: "in_memory" or "snowflake"
STORAGE_BACKEND=in_memory

# Snowflake Connection Details (Used when STORAGE_BACKEND=snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=FACTORY_RELIABILITY_DEV
SNOWFLAKE_SCHEMA=FACTORY_CORE
SNOWFLAKE_ROLE=RELIABILITY_ENGINEER

# Reliability Thresholds
ANOMALY_ZSCORE_THRESHOLD=2.5
FAILURE_RISK_ALERT_THRESHOLD=0.75
BEARING_VIBRATION_RMS_LIMIT_G=0.75
TEMPERATURE_WARNING_LIMIT_C=75.0

# Feature Flags
ENABLE_AUTO_WORK_ORDERS=false
REQUIRE_HUMAN_APPROVAL_FOR_CRITICAL_ASSETS=true
