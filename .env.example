# Environment Configuration for DeRule
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env for local overrides.

APP_ENV=development
APP_NAME="DeRule"
LOG_LEVEL=INFO

# Storage Backend: "in_memory" or "snowflake"
STORAGE_BACKEND=in_memory

# Snowflake Connection Details (Used when STORAGE_BACKEND=snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Authentication: set SNOWFLAKE_PASSWORD for password auth, OR SNOWFLAKE_PRIVATE_KEY_PATH for key-pair auth
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_AUTHENTICATOR=snowflake
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=COCO_FACTORY
SNOWFLAKE_SCHEMA=CORE
SNOWFLAKE_ROLE=RELIABILITY_ENGINEER

# Canonical Data Source Root (Directory containing 19 canonical entities)
COCO_FACTORY_SOURCE_ROOT=C:\Users\shubh\Desktop\oee_v2

# Reliability Thresholds
ANOMALY_ZSCORE_THRESHOLD=2.5
FAILURE_RISK_ALERT_THRESHOLD=0.65
BEARING_VIBRATION_RMS_LIMIT_G=0.75
TEMPERATURE_WARNING_LIMIT_C=75.0

# Feature Flags
ENABLE_AUTO_WORK_ORDERS=false
REQUIRE_HUMAN_APPROVAL_FOR_CRITICAL_ASSETS=true
